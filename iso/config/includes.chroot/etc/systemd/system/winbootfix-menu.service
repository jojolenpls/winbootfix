[Unit]
Description=winbootfix menu on the first console
After=systemd-user-sessions.service live-config.service
Conflicts=getty@tty1.service
Before=getty.target

[Service]
Type=idle
ExecStart=/usr/local/bin/winbootfix-menu
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=1
Environment=TERM=linux LANG=C.UTF-8

[Install]
WantedBy=multi-user.target
